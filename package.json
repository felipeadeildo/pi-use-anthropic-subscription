{
  "name": "pi-claude-max",
  "version": "1.1.1",
  "description": "Pi extension that consumes Claude Pro/Max subscription usage instead of extra usage.",
  "type": "module",
  "license": "MIT",
  "author": "Braden Lamb <hi@braden.lol>",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "anthropic",
    "claude",
    "claude-max",
    "claude-code",
    "subscription",
    "billing",
    "oauth"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bradennss/pi-claude-max.git"
  },
  "homepage": "https://github.com/bradennss/pi-claude-max#readme",
  "bugs": {
    "url": "https://github.com/bradennss/pi-claude-max/issues"
  },
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    }
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm test",
    "prepack": "pnpm run check"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "esbuild",
      "protobufjs"
    ]
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
